---
import BrandMark from "@/components/BrandMark.astro";
import { menuLinks } from "@/site.config";

const isHome = Astro.url.pathname === "/";
---

<footer
	class="text-muted mt-auto flex w-full flex-col items-center justify-center gap-y-2 pt-20 pb-4 text-center align-top font-semibold sm:flex-row sm:justify-between sm:text-xs"
>
	<div class="me-0 sm:me-4">
		{
			isHome ? (
				<span class="text-muted font-mono text-[10px] font-medium tracking-[0.18em] opacity-45" aria-label="Eden · KERNEL PANIC">
					EDEN · KERNEL PANIC_
				</span>
			) : (
				<BrandMark compact />
			)
		}
	</div>
	<nav aria-label="Footer" class="sm:divide-muted flex gap-x-2 sm:gap-x-0 sm:divide-x">
		{
			menuLinks.map((link) => (
				<a class="hover:text-global-text px-4 py-2 hover:underline sm:py-0" href={link.path}>
					{link.title}
				</a>
			))
		}
	</nav>
</footer>
